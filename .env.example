# ============================================================
# XenTriX'26 Prompt Engineering Challenge - Configuration
# ============================================================

# Server Port
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# JWT & Session Secrets
JWT_SECRET=xentrix-2026-super-secret-jwt-key-innovate-inspire-elevate
SESSION_SECRET=xentrix-session-secret-2026

# Database Configuration
# If DATABASE_URL is provided, backend connects to PostgreSQL (Neon, Supabase, Render, local Postgres)
# If empty, built-in SQLite persistence (data/xentrix.sqlite) runs out-of-the-box with zero setup!
DATABASE_URL=
DB_SSL=false

# Default Admin Credentials (Auto-seeded on first run)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=Admin@XenTriX2026
