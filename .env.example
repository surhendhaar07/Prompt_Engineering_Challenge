# ============================================================
# XenTriX'26 Prompt Engineering Challenge - Configuration
# ============================================================

# Server Port
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# JWT & Session Secrets
JWT_SECRET=xentrix-2026-super-secret-jwt-key-innovate-inspire-elevate
SESSION_SECRET=xentrix-session-secret-2026

# Database Configuration (PostgreSQL: Neon / Railway / Cloud)
# Paste your Neon or Railway PostgreSQL connection string here:
# Example Neon:    postgresql://user:pass@ep-cool-project.us-east-2.aws.neon.tech/neondb?sslmode=require
# Example Railway: postgresql://postgres:pass@roundhouse.proxy.rlwy.net:12345/railway
# If left empty, the project automatically uses built-in SQLite (data/xentrix.sqlite)
DATABASE_URL=

# Default Admin Credentials (Auto-seeded on first run)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=Admin@XenTriX2026
